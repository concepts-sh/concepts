{
  "name": "concepts-sh",
  "version": "0.1.0",
  "description": "Concepts, an open format for agent knowledge: init, check and wiki for a .concepts/ folder.",
  "license": "MIT",
  "homepage": "https://concepts.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concepts-sh/concepts.git"
  },
  "type": "module",
  "bin": {
    "concepts": "dist/concepts.mjs"
  },
  "files": [
    "dist",
    "skills",
    "SPEC.md"
  ],
  "scripts": {
    "build": "bun build cli/concepts.ts --target=node --outfile dist/concepts.mjs",
    "prepublishOnly": "bun run build",
    "check": "bun cli/concepts.ts check",
    "wiki": "bun cli/concepts.ts wiki",
    "site": "bun site/build.ts",
    "serve": "bun site/serve.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agents",
    "concepts",
    "knowledge",
    "AGENTS.md",
    "skills",
    "markdown"
  ]
}
